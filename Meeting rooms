class Solution {
  public:
    bool canAttend(vector<vector<int>> &arr) {
        // Code Here
        int n = arr.size()-1;
        sort(arr.begin(), arr.end());
        
        for(int i=0;i<n;i++){
           if(arr[i][1]> arr[i+1][0]){
               return false;
           }
        }
        return true;
    }
};
