class Solution {
public:
    vector<int> topKFrequent(vector<int>& nums, int k) {
        priority_queue<pair<int,int>>pq;

        unordered_map<int,int> mp;

        for(int i:nums){
            mp[i]++;

        }
        for(auto i:mp){
            pq.push({i.second, i.first});
        }
        vector<int>ans;
        while(k>0){
            auto[x,y]= pq.top();

            ans.push_back(y);
            pq.pop();
            k--;
        }
        return ans ;
    }
};



