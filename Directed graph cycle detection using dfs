class Solution {
private:
    bool dfscheck(int node, vector<int> adj[], int vis[], int pathvis[]) {
        vis[node] = 1;
        pathvis[node] = 1;

        for (auto it : adj[node]) {
            if (!vis[it]) {
                if (dfscheck(it, adj, vis, pathvis))
                    return true;
            }
            else if (pathvis[it]) {
                return true;
            }
        }

        pathvis[node] = 0;
        return false;
    }

public:
    bool isCyclic(int V, vector<vector<int>> &edges) {

        vector<int> adj[V];

        // Build adjacency list
        for (auto edge : edges) {
            int u = edge[0];
            int v = edge[1];

            adj[u].push_back(v);
        }

        int vis[V] = {0};
        int pathvis[V] = {0};

        for (int i = 0; i < V; i++) {
            if (!vis[i]) {
                if (dfscheck(i, adj, vis, pathvis))
                    return true;
            }
        }

        return false;
    }
};
