class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        int n = nums.size();
        vector<int> ans;

        sort(nums.begin(), nums.end());

        for (int i = 0; i < n; i++) {
            int cnt = 1;

            for (int j = i + 1; j < n; j++) {
                if (nums[i] == nums[j]) {
                    cnt++;
                } else {
                    break;
                }
            }

            if (cnt > n / 3) {
                ans.push_back(nums[i]);
            }

            i += cnt - 1;
        }

        return ans;
    }
};
