class Solution {
    static bool cmp(vector<int>& a, vector<int>& b){
        return a[1] < b[1];
    }
public:
    int eraseOverlapIntervals(vector<vector<int>>& intervals) {
        sort(intervals.begin(),intervals.end(),cmp);
        int l=intervals[0][0],h=intervals[0][1];
        int ans=0;
        for(int i=1;i<intervals.size();i++)
        {
            int s=intervals[i][0];
            int e=intervals[i][1];
            if(s<h)
            {
                ans++;
            }
            else
            {
                h=e;
                l=s;
            }
        }
        return ans;
    }
};
